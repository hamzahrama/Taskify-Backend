# Set this to Railway PostgreSQL's DATABASE_URL in Railway and to a reachable
# PostgreSQL instance when running the backend locally.
DATABASE_URL="postgresql://user:password@localhost:5432/taskify?schema=public"
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=
FRONTEND_URL=http://localhost:3000
PORT=4000
